# =========================================================================
# Cademo — modèle de fichier d'environnement
#
# Copie ce fichier en `.env` (sans .example) dans le même dossier, puis
# remplis les valeurs. Le vrai .env NE DOIT PAS être commité — il est déjà
# dans .gitignore (voir la racine si besoin).
#
# Sous PowerShell :
#   Copy-Item .env.example .env
# Puis ouvre .env dans ton éditeur et remplace les valeurs.
# =========================================================================


# ---- API /api/verify-account -------------------------------------------
# Choix du back-end : "pg" (Supabase / PostgreSQL) ou "mongo".
DB=pg

# Postgres (Supabase → Project Settings → Database → Connection string).
# Le mot de passe est celui que TU as défini à la création du projet.
DATABASE_URL=postgresql://postgres:MOTDEPASSE@db.vmmicbfoobdbtikcqxel.supabase.co:5432/postgres

# MongoDB (si DB=mongo au lieu de pg).
# MONGO_URL=mongodb://localhost:27017
# MONGO_DB=cademo

# Port d'écoute HTTP (défaut 3000).
PORT=3000

# Optionnel : secret partagé. Si défini, l'appelant doit envoyer
# le header X-Cademo-Secret avec la même valeur, sinon 401.
# API_SECRET=change-moi-en-un-secret-long


# ---- Module IMAP (imap-check.js) ---------------------------------------
# Mode d'authentification : "password" ou "oauth2".
IMAP_MODE=password

# Serveur IMAP.
#   Gmail :          imap.gmail.com     port 993
#   Outlook / M365 : outlook.office365.com  port 993
#   iCloud :         imap.mail.me.com   port 993
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true

# Adresse email à interroger.
IMAP_USER=ton.adresse@gmail.com

# Boîte à lire (défaut INBOX). Exemples : INBOX, [Gmail]/All Mail, Sent.
IMAP_MAILBOX=INBOX

# Nombre de derniers messages à récupérer par appel.
IMAP_LIMIT=10

# Journalisation détaillée du protocole IMAP (à laisser sur false en usage).
IMAP_LOG=false

# --- Mode "password" ----------------------------------------------------
# ⚠️  Gmail n'accepte PLUS le vrai mot de passe. Il faut un App Password
#     (16 caractères sans espaces) créé dans le compte Google →
#     Sécurité → « Mots de passe des applications ».
IMAP_PASSWORD=xxxxxxxxxxxxxxxx

# --- Mode "oauth2" (Gmail uniquement) -----------------------------------
# Créer une app OAuth dans Google Cloud Console :
#   1. https://console.cloud.google.com/ → APIs & Services → Credentials
#   2. Create OAuth client → Desktop → note client_id + client_secret
#   3. Autoriser le scope "https://mail.google.com/"
#   4. Récupérer un refresh_token via OAuth Playground ou un flow local.
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# GOOGLE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxx


# ---- Sauvegarde de config OAuth (config-store.js) ----------------------
# Backend : "file" (JSON local chiffré) ou "pg" (Postgres, table oauth_configs).
CONFIG_STORE=file

# Emplacement du fichier local si CONFIG_STORE=file.
# (le fichier est CHIFFRÉ, illisible sans MASTER_KEY)
CONFIG_FILE=.config-store.json

# Clé maître utilisée pour chiffrer les refresh_tokens (AES-256-GCM).
# Génère-la UNE FOIS avec cette commande PowerShell :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️  Si tu la perds ou la changes, TOUS les tokens stockés deviennent
#    illisibles. Sauvegarde-la à part.
MASTER_KEY=change-moi-avec-32-octets-hex-generes-avec-la-commande-ci-dessus


# ---- Envoi de mails de validation (mail-sender.js) ---------------------
# Compte Gmail qui SERT à envoyer les mails de validation (le tien).
# Les utilisateurs de l'app n'ont RIEN à configurer — ils recoivent juste
# un mail dans leur boîte.
#
# App Password (16 caractères sans espaces) à créer ICI :
#   https://myaccount.google.com/apppasswords
#   (prerequis : Validation en 2 étapes activée sur ton compte Google)
GMAIL_USER=neyvo.entreprise@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
