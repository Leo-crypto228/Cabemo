# ===========================================
# CONFIGURATION OBLIGATOIRE
# ===========================================

# Supabase - pour stocker/récupérer les credentials
SUPABASE_URL=https://vmmicbfoobdbtikcqxel.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Master key pour chiffrer les sessions cookies
MASTER_KEY=change-moi-avec-une-cle-aleatoire-de-32-caracteres

# Port du serveur
PORT=8080

# ===========================================
# CONFIGURATION RECOMMANDÉE (Proxy)
# ===========================================
# Pour 500 comptes, il FAUT des proxies résidentiels
# Mets USE_PROXY=true ET configure PROXY_POOL dans worker/proxy-rotator.js
USE_PROXY=false

# ===========================================
# OLLAMA (local LLM)
# ===========================================
# Assure-toi qu'Ollama tourne sur localhost:11434
# Modèle recommandé : llama3.2 ou mistral
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2